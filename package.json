{
  "name": "claude-business-landing-pages",
  "version": "1.0.0",
  "description": "Test-driven development framework for 20 AI-powered business landing pages with 5 varieties each",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:lighthouse": "node scripts/lighthouse-ci.js",
    "test:all": "npm run test && npm run test:e2e && npm run test:lighthouse",
    "lint:html": "node scripts/validate-html.js",
    "lint:css": "stylelint '**/*.css'",
    "lint:js": "eslint '**/*.js'",
    "validate-analytics": "node scripts/validate-analytics.js",
    "build:landing-page": "node scripts/build-landing-page.js",
    "serve": "python3 -m http.server 8000",
    "deploy": "node scripts/deploy-to-github-pages.js"
  },
  "keywords": [
    "landing-pages",
    "a-b-testing",
    "conversion-optimization",
    "tdd",
    "ai-business"
  ],
  "author": "Claude Business Samples",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/dom": "^9.3.3",
    "@testing-library/jest-dom": "^6.1.5",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^23.0.1",
    "lighthouse": "^11.4.0",
    "lighthouse-ci": "^0.12.1",
    "puppeteer": "^21.6.1",
    "stylelint": "^16.0.2",
    "stylelint-config-standard": "^36.0.0"
  },
  "dependencies": {},
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
    "testMatch": [
      "**/tests/unit/**/*.test.js",
      "**/tests/integration/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "**/v*/script.js",
      "**/shared/analytics.js",
      "!**/node_modules/**",
      "!**/tests/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
